public class Main {
    public static void main(String[] args) {
        int[] arr = {2, 3, 2, 5, 3, 2};
        int n = 6;
        int[] freq = new int[10]; // Automatically initialized to 0 in Java

        for (int i = 0; i < n; i++) {
            freq[arr[i]]++;
        }

        for (int i = 0; i < 10; i++) {
            if (freq[i] > 0) {
                System.out.println(i + " occurs " + freq[i] + " times");
            }
        }
    }
}

