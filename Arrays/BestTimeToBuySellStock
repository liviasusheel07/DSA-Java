class Solution {
    public int maxProfit(int[] prices) {
        int i, profit = 0;
        int maxprofit = 0;
        int n = prices.length;
        
        if (n == 0) return 0;
        
        int minPrice = prices[0];

        for (i = 0; i < n; i++) {
            if (prices[i] < minPrice) {
                minPrice = prices[i]; 
            }
            profit = prices[i] - minPrice;
            if (maxprofit < profit) {
                maxprofit = profit;
            }
        }

        return maxprofit;
    }
}
