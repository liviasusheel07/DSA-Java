class Solution {
    public int[] twoSum(int[] nums, int target) {
        int n = nums.length;
        
        for (int i = 0; i < n; i++) {
        
            for (int j = i + 1; j < n; j++) {
                if (nums[i] + nums[j] == target) {
                    return new int[] { i, j }; // Found the pair, return immediately
                }
            }
        }
        return new int[] {}; // Return empty if no solution found
    }
}


//optimised using 2pointers
#include <stdio.h>

int main() {
    int arr[] = {1, 2, 3, 4, 6, 8};
    int n = 6;
    int target = 10;

    int left = 0;
    int right = n - 1;

    while (left < right) {

        int sum = arr[left] + arr[right];

        if (sum == target) {
            printf("Pair: %d %d\n", arr[left], arr[right]);
            return 0;
        }

        else if (sum < target) {
            left++;
        }

        else {
            right--;
        }
    }

    printf("No pair found\n");

    return 0;
}
