//optimal solution -O(n) using 2 pointers and changing left or right , acc to which ht is small, as width will be max if left and right are far apart
class Solution {
    public int maxArea(int[] height) {
       int left =0;
       int right = height.length-1;
       int maxarea=0;
       int area;
       while(left<=right)
       {
        area=(right-left)*Math.min(height[left],height[right]);
        maxarea=Math.max(area,maxarea);
        if(height[left]<height[right])
        left++;
        else
        right--;
       }
       return maxarea;
}

}




//brute force approach O(n^2)

class Solution {
    public int maxArea(int[] height) {
        int area= 0;
        int maxarea=0;
        int n = height.length;
        int i,j;
        for(i=0;i<n;i++)
        {
            for(j=i+1;j<n;j++)
            {
                area=((j-i)*(Math.min(height[i],height[j])));
               maxarea= Math.max(maxarea,area);

        }
        
    }
    return maxarea;
}

}


