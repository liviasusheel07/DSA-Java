//first sort it, to eliminate triplets
//after sorting the triplets they'll always be unique
//brute : On^3 by haivnh three loops (for i=0;j+i+1;k=j+1) and then putting if condition to get triplets and then sort them for unique triplets
//arr[k]=-(arr[i]+arr[j])

//brute force:
class Solution {
    public List<List<Integer>> threeSum(int[] nums) {

        List<List<Integer>> arr = new ArrayList<>();

        for (int i = 0; i < nums.length; i++) {

            for (int j = i + 1; j < nums.length; j++) {

                for (int k = j + 1; k < nums.length; k++) {

                    if (nums[i] + nums[j] + nums[k] == 0) {

                        List<Integer> temp = new ArrayList<>();

                        temp.add(nums[i]);
                        temp.add(nums[j]);
                        temp.add(nums[k]);

                        arr.add(temp);
                    }
                }
            }
        }

        return arr;
    }
}

