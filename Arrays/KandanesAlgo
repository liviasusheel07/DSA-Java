class Solution {
    public int maxSubArray(int[] nums) {
        int currsum=nums[0];
        int maxsum=nums[0];
        int i;
        for(i=1;i<nums.length;i++)
        {
          if(nums[i]<currsum+nums[i])
          {
            currsum=currsum+nums[i];
          }
          else
          currsum=nums[i];
          if (currsum>maxsum)
          maxsum=currsum;
          
        }
        return maxsum;
        
    }
}
